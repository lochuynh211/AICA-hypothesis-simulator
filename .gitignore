.agents/
.specify/
.worktrees/
AGENTS.md

CLAUDE.md

# .claude/ stays ignored except .claude/rules/, which holds tracked path-scoped
# rules. Git cannot re-include a file whose parent directory is excluded, so the
# directory is un-ignored first and its contents re-ignored, leaving rules/ only.
!.claude/
.claude/*
!.claude/rules/

# ivi-building is a tracked project: its skills, agents, and project definition
# are deliverables, not local config. Personal settings stay ignored above.
!ivi-building/.claude/
!ivi-building/CLAUDE.md

# Customer-confidential material must never leave this machine. The TYM domain
# pack holds primary sources marked PROTECTED / 関係者外秘; run artifacts,
# prototypes, and generated output are derived from them and inherit that
# confidentiality. Only the directory structure is tracked, so a clone gets the
# shape of the pack without its contents. domain/_template/ stays tracked: it is
# a generic skeleton with no customer content.
ivi-building/domain/tym/**
!ivi-building/domain/tym/**/
!ivi-building/domain/tym/**/.gitkeep
ivi-building/runs/**
!ivi-building/runs/**/
!ivi-building/runs/**/.gitkeep
ivi-building/prototypes/**
!ivi-building/prototypes/**/
!ivi-building/prototypes/**/.gitkeep
ivi-building/generated/**
!ivi-building/generated/**/
!ivi-building/generated/**/.gitkeep

.codex/
.superpowers/
.codegraph/
.venv/
*.egg-info/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/
dist/
build/pyinstaller_work/

artifacts/
.understand-anything/

# Local secrets / live-adapter credentials (never commit)
.env
.env.local

# BYO-key runtime placeholders for networked-surface targets (never commit a key)
*.local.js
key.local.js

# Run evidence logs (only .gitkeep is tracked)
runs/*.json
proposal_runs/*.json
merged_runs/*.json
corporate-proxy.crt

# Local Docker Compose proxy overrides (.env.example is the tracked template)
.env

# Proposal-simulator local user artifacts (P3) — never committed
proposal_profiles/
proposal_worlds/

# Music dataset generator workspace.
# Committed for cross-machine resume (raw cache + ledger + lineage are the resumable
# state, design §4.13) — BUT credentials are NEVER committed.
generation_workspace/soundcharts.env
generation_workspace/*.env
generation_workspace/**/*.env

# SpecKit implementation-scratch subagent reports + review packages
specs/*/.reports/

# feature 019 in-browser Nano test harness eval sink
proposal_runs/nano-test/

# htmlapp generated data seam (regenerate with: npm run build:data)
htmlapp/frontend/data/
htmlapp/frontend/public/aica-data.js

# Debug-only capture/build scripts + screenshots (never shipped)
others/debug/

# Vitest run cache (local test-runner state, never committed)
.vite/

# htmlapp pre-mirror backup (local snapshot before nri-forecast-rest mirror; never committed)
htmlapp_backup_pre-nri-forecast/
