      "default": [],
      "items": {
        "$ref": "#/$defs/SetupSnapshot"
      },
      "title": "Setup Snapshot History",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ProposalRunStatus"
    },
    "world": {
      "anyOf": [
        {
          "$ref": "#/$defs/World"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "world_snapshot": {
      "additionalProperties": true,
      "title": "World Snapshot",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "opportunity",
    "matrix_version",
    "world_snapshot",
    "service_package_id",
    "content_package_id",
