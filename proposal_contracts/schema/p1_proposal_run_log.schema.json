  "description": "Full append-only record persisted to ``proposal_runs/<run_id>.json``.\n\nRules (enforced by the run manager, not this model): append-only;\npersisted atomically after each event; reopen renders from this log\nwithout recomputation; created/edited entirely within ``proposal_runs/``\n(never touches trigger ``runs/``).\n\n``setup_snapshot`` (P3, feature 014) is an ADDITIVE field: it freezes the\ntyped provenance of what produced the run (data-model.md §SetupSnapshot,\nresearch.md §R6). It is optional and defaults to ``None`` so that\nexisting runs persisted before P3 (which only ever populated the opaque\n``world_snapshot`` dict) still load unchanged. The run-create ENDPOINT\nmigration to actually populate ``setup_snapshot`` (and eventually retire\n``world_snapshot``) is a later P3 task — this model only adds the shape.",
  "properties": {
    "content_hyperparameters": {
      "additionalProperties": true,
      "default": {},
      "title": "Content Hyperparameters",
      "type": "object"
    },
    "content_package_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Content Package Id"
    },
    "content_parameters": {
      "additionalProperties": true,
      "default": {},
      "title": "Content Parameters",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/DiscreteEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/AlgorithmEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "explanations": {
      "items": {
        "$ref": "#/$defs/Explanation"
      },
      "title": "Explanations",
      "type": "array"
    },
    "hyperparameters": {
      "additionalProperties": true,
      "title": "Hyperparameters",
      "type": "object"
    },
    "journey_state": {
      "$ref": "#/$defs/JourneyState"
    },
    "matrix_version": {
      "title": "Matrix Version",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/ProposalRunMode",
      "default": "interactive"
    },
    "opportunity": {
      "$ref": "#/$defs/ProposalOpportunity"
    },
    "opportunity_history": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposalOpportunity"
      },
      "title": "Opportunity History",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "service_package_id": {
      "title": "Service Package Id",
      "type": "string"
    },
    "setup_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/SetupSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
