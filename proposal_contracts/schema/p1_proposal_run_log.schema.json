{
  "$defs": {
    "AgeBand": {
      "description": "Driver age band (spec §9; keys mirror the content selector's age_era_affinity table).",
      "enum": [
        "teens",
        "20s",
        "30s",
        "40s",
        "50s",
        "60plus"
      ],
      "title": "AgeBand",
      "type": "string"
    },
    "AlgorithmEvidence": {
      "description": "Per-evaluation evidence appended to a ``ProposalRunLog``.",
      "properties": {
        "contract_version": {
          "title": "Contract Version",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceError"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_snapshot": {
          "additionalProperties": true,
          "title": "Input Snapshot",
          "type": "object"
        },
        "matrix_version": {
          "title": "Matrix Version",
          "type": "string"
        },
        "missing_features": {
          "items": {
            "type": "string"
          },
          "title": "Missing Features",
          "type": "array"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output"
        },
        "package_id": {
          "title": "Package Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "step": {
          "enum": [
            "service",
            "content"
          ],
          "title": "Step",
          "type": "string"
        },
        "unused_available_features": {
          "items": {
            "type": "string"
          },
          "title": "Unused Available Features",
          "type": "array"
        },
        "used_feature_ids": {
          "items": {
            "type": "string"
          },
          "title": "Used Feature Ids",
          "type": "array"
        }
      },
      "required": [
        "step",
        "package_id",
        "contract_version",
        "schema_version",
        "matrix_version",
        "input_snapshot",
        "output",
        "error",
        "used_feature_ids",
        "unused_available_features",
        "missing_features"
      ],
      "title": "AlgorithmEvidence",
      "type": "object"
    },
    "CancelledContentPlan": {
      "additionalProperties": false,
      "description": "One cancelled content-plan record (spec §9: \"timestamped plan record array\").",
      "properties": {
        "cancelled_at": {
          "title": "Cancelled At",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "cancelled_at"
      ],
      "title": "CancelledContentPlan",
      "type": "object"
    },
    "CatalogRef": {
      "additionalProperties": false,
      "description": "Lightweight, immutable reference to a frozen dataset.\n\n``dataset_id`` + ``dataset_version`` + ``dataset_hash`` — enough to pin\nexactly which frozen catalog a ``World`` (a later P3 task) is drawing\nsongs from, without embedding the full provenance note. Read-only:\n``frozen=True``, no edit/mutate method.",
      "properties": {
        "dataset_hash": {
          "title": "Dataset Hash",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "$ref": "#/$defs/DatasetVersion"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "dataset_hash"
      ],
      "title": "CatalogRef",
      "type": "object"
    },
    "ChangedFromItem": {
      "additionalProperties": false,
      "description": "One changed-from-item history entry (``track_id``, ``changed_at``).",
      "properties": {
        "changed_at": {
          "title": "Changed At",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "changed_at"
      ],
      "title": "ChangedFromItem",
      "type": "object"
    },
    "CompletedItem": {
      "additionalProperties": false,
      "description": "One completed-item history entry (Additional proposed / Granular operations).",
      "properties": {
        "completed_at": {
          "title": "Completed At",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "completed_at"
      ],
      "title": "CompletedItem",
      "type": "object"
    },
    "ControlInputs": {
      "additionalProperties": false,
      "description": "The run's control inputs (data-model.md §ControlInputs).\n\n``matrix_version``/``dataset_id`` are validated here only for non-emptiness;\nactual resolvability against the matrix/dataset registries is a service-layer\nconcern (``services/world_validation.py``, a later P3 task), not this model.",
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "lifecycle_stage": {
          "$ref": "#/$defs/LifecycleStage"
        },
        "matrix_version": {
          "title": "Matrix Version",
          "type": "string"
        },
        "motion_state": {
          "$ref": "#/$defs/MotionState"
        },
        "trigger_purpose": {
          "$ref": "#/$defs/TriggerPurpose"
        }
      },
      "required": [
        "trigger_purpose",
        "lifecycle_stage",
        "motion_state",
        "matrix_version",
        "dataset_id"
      ],
      "title": "ControlInputs",
      "type": "object"
    },
    "DatasetVersion": {
      "additionalProperties": false,
      "description": "Schema / track / audio-feature reference versions for a dataset.\n\nRead-only, immutable — mirrors the corresponding ``dataset_manifest.json``\nfields verbatim.",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "spotify_audio_features_reference_version": {
          "title": "Spotify Audio Features Reference Version",
          "type": "string"
        },
        "spotify_track_reference_version": {
          "title": "Spotify Track Reference Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "spotify_track_reference_version",
        "spotify_audio_features_reference_version"
      ],
      "title": "DatasetVersion",
      "type": "object"
    },
    "DiscreteEvent": {
      "description": "A single discrete event appended to a ``ProposalRunLog`` (append-only\nin usage; this model just holds the shape).",
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "At"
        },
        "event_type": {
          "$ref": "#/$defs/DiscreteEventType"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "event_type",
        "at",
        "payload"
      ],
      "title": "DiscreteEvent",
      "type": "object"
    },
    "DiscreteEventType": {
      "description": "Discrete event kinds appended to a ``ProposalRunLog`` (shape/enum only in\nP1; only ``OPPORTUNITY_OPENED``, ``SERVICE_SELECTED``, ``CONTENT_SELECTED``,\nand ``ALGORITHM_ERROR`` are actually emitted by the P1 mock flow).",
      "enum": [
        "OPPORTUNITY_OPENED",
        "SERVICE_SELECTED",
        "CONTENT_SELECTED",
        "TRIGGER_PURPOSE_CHANGED",
        "REST_SPOT_ARRIVED",
        "REST_COMPLETED",
        "CONTENT_COMPLETED",
        "ALGORITHM_ERROR",
        "SERVICE_REJECTED",
        "CONTENT_STARTED",
        "MOTION_CHANGED",
        "CONTINUE_REQUESTED",
        "RETURN_TO_PREVIOUS_CONTENT",
        "REST_STARTED",
        "POSTPONED",
        "CHOOSE_ANOTHER",
        "REQUEST_MORE",
        "NO_ELIGIBLE_CANDIDATE",
        "RECOMPUTED",
        "CONTEXT_EDITED"
      ],
      "title": "DiscreteEventType",
      "type": "string"
    },
    "DriverProfile": {
      "additionalProperties": false,
      "description": "Preference + history + profile-side additional-proposed fields + the\nopt-in genre extension (data-model.md §DriverProfile).\n\nField groupings below reflect the UI/editing grouping (Preference / History /\ngenre extension); ``World.project()`` re-buckets some of these fields into\n``feature_snapshot[\"additional_proposed\"]`` per the disposition registry\n(``completed_items``/``manually_selected_items``/``repeated_items`` from\nPreference; the four ``*_confidence`` maps from History).",
      "properties": {
        "age_band": {
          "$ref": "#/$defs/AgeBand"
        },
        "cancelled_content_plans": {
          "items": {
            "$ref": "#/$defs/CancelledContentPlan"
          },
          "title": "Cancelled Content Plans",
          "type": "array"
        },
        "catalog_item_recency_state": {
          "additionalProperties": {
            "$ref": "#/$defs/RecencyState"
          },
          "title": "Catalog Item Recency State",
          "type": "object"
        },
        "catalog_item_usage_level": {
          "additionalProperties": {
            "$ref": "#/$defs/UsageLevel"
          },
          "title": "Catalog Item Usage Level",
          "type": "object"
        },
        "changed_from_items": {
          "items": {
            "$ref": "#/$defs/ChangedFromItem"
          },
          "title": "Changed From Items",
          "type": "array"
        },
        "completed_items": {
          "items": {
            "$ref": "#/$defs/CompletedItem"
          },
          "title": "Completed Items",
          "type": "array"
        },
        "content_proposal_acceptance_confidence": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Content Proposal Acceptance Confidence",
          "type": "object"
        },
        "content_proposal_acceptance_rate": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Content Proposal Acceptance Rate",
          "type": "object"
        },
        "content_recovery_confidence": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Content Recovery Confidence",
          "type": "object"
        },
        "content_recovery_rate": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Content Recovery Rate",
          "type": "object"
        },
        "content_tag_recency_state": {
          "additionalProperties": {
            "$ref": "#/$defs/RecencyState"
          },
          "title": "Content Tag Recency State",
          "type": "object"
        },
        "content_tag_usage_level": {
          "additionalProperties": {
            "$ref": "#/$defs/UsageLevel"
          },
          "title": "Content Tag Usage Level",
          "type": "object"
        },
        "gender": {
          "$ref": "#/$defs/Gender"
        },
        "genre_affinity_v1_enabled": {
          "default": false,
          "title": "Genre Affinity V1 Enabled",
          "type": "boolean"
        },
        "hobby_interest_tags": {
          "items": {
            "type": "string"
          },
          "title": "Hobby Interest Tags",
          "type": "array"
        },
        "manually_selected_items": {
          "items": {
            "$ref": "#/$defs/ManuallySelectedItem"
          },
          "title": "Manually Selected Items",
          "type": "array"
        },
        "oshi_artists": {
          "items": {
            "$ref": "#/$defs/OshiArtist"
          },
          "title": "Oshi Artists",
          "type": "array"
        },
        "oshi_mode": {
          "$ref": "#/$defs/OshiMode"
        },
        "oshi_registered": {
          "title": "Oshi Registered",
          "type": "boolean"
        },
        "oshi_tags": {
          "items": {
            "type": "string"
          },
          "title": "Oshi Tags",
          "type": "array"
        },
        "played_items": {
          "items": {
            "$ref": "#/$defs/PlayedItem"
          },
          "title": "Played Items",
          "type": "array"
        },
        "repeated_items": {
          "items": {
            "$ref": "#/$defs/RepeatedItem"
          },
          "title": "Repeated Items",
          "type": "array"
        },
        "scene_content_tag_usage_level": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/UsageLevel"
            },
            "type": "object"
          },
          "title": "Scene Content Tag Usage Level",
          "type": "object"
        },
        "scene_genre_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "$ref": "#/$defs/UsageLevel"
                },
                "propertyNames": {
                  "$ref": "#/$defs/GenreLiteral"
                },
                "type": "object"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Genre Usage"
        },
        "scene_service_usage_level": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/UsageLevel"
            },
            "propertyNames": {
              "$ref": "#/$defs/ServiceId"
            },
            "type": "object"
          },
          "title": "Scene Service Usage Level",
          "type": "object"
        },
        "scheduled_event_tags": {
          "items": {
            "type": "string"
          },
          "title": "Scheduled Event Tags",
          "type": "array"
        },
        "scheduled_event_timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduledEventTiming"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheduled_event_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduledEventType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "service_proposal_acceptance_confidence": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/ServiceId"
          },
          "title": "Service Proposal Acceptance Confidence",
          "type": "object"
        },
        "service_proposal_acceptance_rate": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/ServiceId"
          },
          "title": "Service Proposal Acceptance Rate",
          "type": "object"
        },
        "service_recency_state": {
          "additionalProperties": {
            "$ref": "#/$defs/RecencyState"
          },
          "propertyNames": {
            "$ref": "#/$defs/ServiceId"
          },
          "title": "Service Recency State",
          "type": "object"
        },
        "service_recovery_confidence": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/ServiceId"
          },
          "title": "Service Recovery Confidence",
          "type": "object"
        },
        "service_recovery_rate": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/ServiceId"
          },
          "title": "Service Recovery Rate",
          "type": "object"
        },
        "service_usage_level": {
          "additionalProperties": {
            "$ref": "#/$defs/UsageLevel"
          },
          "propertyNames": {
            "$ref": "#/$defs/ServiceId"
          },
          "title": "Service Usage Level",
          "type": "object"
        },
        "skipped_items": {
          "items": {
            "$ref": "#/$defs/SkippedItem"
          },
          "title": "Skipped Items",
          "type": "array"
        },
        "usage_by_genre": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/UsageLevel"
              },
              "propertyNames": {
                "$ref": "#/$defs/GenreLiteral"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage By Genre"
        }
      },
      "required": [
        "oshi_registered",
        "oshi_mode",
        "age_band",
        "gender"
      ],
      "title": "DriverProfile",
      "type": "object"
    },
    "EvidenceError": {
      "description": "Structured error detail recorded when an ``evaluate()`` call raises or\nreturns an invalid result.",
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "EvidenceError",
      "type": "object"
    },
    "Explanation": {
      "description": "Append-only narration record persisted in ``ProposalRunLog.explanations``.\n\n``rationale`` is the positional bilingual pair ``[ja, en]`` (the same shape\nthe frontend ``pickRationale`` expects). ``provider_used`` records who\nactually produced the text: ``backend`` (Ollama), ``template`` (deterministic\nfallback after an Ollama failure), or ``browser`` (only when a client chose\nto persist Nano output — not done in v1). ``fell_back`` is True whenever the\nrequested provider failed and the deterministic template was used instead,\nso a review never mistakes a fallback for a real generation.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "fell_back": {
          "title": "Fell Back",
          "type": "boolean"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "provider_used": {
          "enum": [
            "backend",
            "browser",
            "template"
          ],
          "title": "Provider Used",
          "type": "string"
        },
        "rationale": {
          "items": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "array"
        },
        "requested_provider": {
          "enum": [
            "backend",
            "browser"
          ],
          "title": "Requested Provider",
          "type": "string"
        },
        "step": {
          "enum": [
            "service",
            "content"
          ],
          "title": "Step",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "step",
        "target_id",
        "requested_provider",
        "provider_used",
        "model",
        "rationale",
        "fell_back",
        "prompt_hash",
        "generated_at"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "FeatureOriginProvenance": {
      "description": "Provenance of a feature's origin (distinct from response-coefficient provenance — FR-020).",
      "enum": [
        "cdc_su_baseline",
        "normalized_cdc_su_concept",
        "proposed_addition"
      ],
      "title": "FeatureOriginProvenance",
      "type": "string"
    },
    "FeatureProvenanceEntry": {
      "description": "Provenance for a single feature entry in the feature_provenance map.",
      "properties": {
        "feature_origin": {
          "$ref": "#/$defs/FeatureOriginProvenance"
        },
        "source_reference": {
          "title": "Source Reference",
          "type": "string"
        }
      },
      "required": [
        "feature_origin",
        "source_reference"
      ],
      "title": "FeatureProvenanceEntry",
      "type": "object"
    },
    "Gender": {
      "description": "Driver gender (spec §9: \"enum plus unknown\"; default transparent weight is zero).",
      "enum": [
        "male",
        "female",
        "non_binary",
        "unspecified"
      ],
      "title": "Gender",
      "type": "string"
    },
    "GenreLiteral": {
      "description": "Controlled vocabulary of 12 Japanese-market music genres.",
      "enum": [
        "j-pop",
        "j-rock",
        "city pop",
        "anime",
        "vocaloid",
        "enka",
        "children's music",
        "classical",
        "jazz",
        "ambient",
        "electronic",
        "japanese folk"
      ],
      "title": "GenreLiteral",
      "type": "string"
    },
    "JourneyState": {
      "description": "A snapshot of the journey at a point in the proposal run.",
      "properties": {
        "active_plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Plan Id"
        },
        "active_service_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_plan_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Plan Ref"
        },
        "lifecycle_stage": {
          "$ref": "#/$defs/LifecycleStage"
        },
        "motion_state": {
          "$ref": "#/$defs/MotionState"
        },
        "playback_state": {
          "$ref": "#/$defs/PlaybackState",
          "default": "idle"
        },
        "previous_content": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviousContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rejected_service_ids": {
          "items": {
            "$ref": "#/$defs/ServiceId"
          },
          "title": "Rejected Service Ids",
          "type": "array"
        }
      },
      "required": [
        "lifecycle_stage",
        "motion_state",
        "active_service_id",
        "active_plan_id"
      ],
      "title": "JourneyState",
      "type": "object"
    },
    "LifecycleStage": {
      "description": "Driving lifecycle stage at the time of proposal (spec §7).",
      "enum": [
        "before_rest_until_stop",
        "during_rest_stopped",
        "after_rest_before_restart",
        "active_driving_content"
      ],
      "title": "LifecycleStage",
      "type": "string"
    },
    "ManuallySelectedItem": {
      "additionalProperties": false,
      "description": "One manually-selected-item history entry (Additional proposed / Granular operations).",
      "properties": {
        "selected_at": {
          "title": "Selected At",
          "type": "string"
        },
        "track_id": {
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "selected_at"
      ],
      "title": "ManuallySelectedItem",
      "type": "object"
    },
    "MotionState": {
      "description": "Vehicle motion state at proposal time (P1 journey-state snapshot).",
      "enum": [
        "driving",
        "stopped"
      ],
      "title": "MotionState",
      "type": "string"
    },
    "NightState": {
      "description": "Day/night driving state (spec §8/§9).",
      "enum": [
        "day",
        "night"
      ],
      "title": "NightState",
      "type": "string"
    },
    "OshiArtist": {
      "additionalProperties": false,
      "description": "One driver-registered favourite (\"oshi\") artist plus the driver's own\n熱狂度 (enthusiasm) for that specific artist (feature 025 slice S2).\n\nReplaces the single top-level ``oshi_id``/``oshi_type`` pair: a driver may\nnow register MULTIPLE oshi artists, each independently intense. See\n``DriverProfile.oshi_artists`` and the content selector's ``oshi`` leaf\n(``packages/aica_transparent_content_selector_v1/algorithm.py``), which\nconsumes ``enthusiasm`` as the per-artist affinity value.",
      "properties": {
        "artist_id": {
