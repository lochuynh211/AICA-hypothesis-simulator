{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aica.local/schema/p1_preset.schema.json",
  "title": "Proposal Preset (P8 test-case)",
  "description": "A committed, read-only proposal-mode preset: binds a full SeedWorld with a bilingual brief, a machine-checkable expectation contract, and optional isolated algorithm-config overrides. Generated by scripts/generate_presets.py; golden-pinned; never hand-edited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["preset_id", "label", "brief", "family", "contrast_with", "world", "algorithm_config_overrides", "expectation", "schema_version"],
  "properties": {
    "preset_id": { "type": "string", "pattern": "^preset-[a-z0-9-]+$" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "label": { "$ref": "#/$defs/bilingual" },
    "brief": { "$ref": "#/$defs/bilingual" },
    "family": {
      "type": "string",
      "enum": ["mood_coherence", "directional_hypothesis", "oshi_personalization", "genre_usage", "route_genre", "era_age", "passenger_genre", "singability_service", "history_mechanics", "baseline", "combo"]
    },
    "contrast_with": { "type": ["string", "null"], "pattern": "^preset-[a-z0-9-]+$" },
    "world": {
      "description": "Full SeedWorld — validated by the existing world.schema.json / World model (control_inputs + situation + driver_profile + catalog_ref). Not re-specified here to avoid divergence.",
      "type": "object"
    },
    "algorithm_config_overrides": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content": { "type": ["object", "null"] },
            "service": { "type": ["object", "null"] }
          }
        }
      ]
    },
    "expectation": { "$ref": "#/$defs/expectation" }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en"],
      "properties": { "ja": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "expectedTop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track_id": { "type": ["string", "null"] },
        "genre": { "type": ["string", "null"] },
        "arousal_band": { "type": ["string", "null"], "enum": ["high", "mid", "low", null] },
        "must_be_oshi": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["track_id"], "properties": { "track_id": { "type": "string" } } },
        { "required": ["genre"], "properties": { "genre": { "type": "string" } } },
        { "required": ["arousal_band"], "properties": { "arousal_band": { "type": "string" } } },
        { "required": ["must_be_oshi"], "properties": { "must_be_oshi": { "const": true } } }
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "expected_top", "top_fit_min", "gradient", "expected_service", "override_required"],
      "properties": {
        "hypothesis": { "type": "string", "minLength": 1 },
        "expected_top": { "$ref": "#/$defs/expectedTop" },
        "top_fit_min": { "type": "number", "minimum": -1, "maximum": 1 },
        "gradient": { "type": "string", "enum": ["arousal_up_implies_fit_up", "arousal_down_implies_fit_up", "none"] },
        "should_rank_below": { "type": "array", "items": { "$ref": "#/$defs/expectedTop" } },
        "expected_service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top_should_be_in"],
          "properties": { "top_should_be_in": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
        },
        "override_required": { "type": "boolean" }
      }
    }
  }
}
