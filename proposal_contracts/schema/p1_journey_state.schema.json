{
  "$defs": {
    "LifecycleStage": {
      "description": "Driving lifecycle stage at the time of proposal (spec §7).",
      "enum": [
        "before_rest_until_stop",
        "during_rest_stopped",
        "after_rest_before_restart",
        "active_driving_content"
      ],
      "title": "LifecycleStage",
      "type": "string"
    },
    "MotionState": {
      "description": "Vehicle motion state at proposal time (P1 journey-state snapshot).",
      "enum": [
        "driving",
        "stopped"
      ],
      "title": "MotionState",
      "type": "string"
    },
    "PlaybackState": {
      "description": "Playback state of the currently active content plan (data-model.md).",
      "enum": [
        "idle",
        "active",
        "backgrounded",
        "paused",
        "completed",
        "stopped"
      ],
      "title": "PlaybackState",
      "type": "string"
    },
    "PreviousContent": {
      "description": "The service/plan that was active before the current one (P4) — used to\nrestore playback when a ``stop`` action returns to prior content.",
      "properties": {
        "plan_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Ref"
        },
        "service_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PreviousContent",
      "type": "object"
    },
    "ServiceId": {
      "description": "Catalog service identifiers (spec §7.1–7.2, 14 services).",
      "enum": [
        "music_playlist",
        "humming_karaoke",
        "call_response_driving",
        "quiz",
        "ranking_creation",
        "radio_style",
        "conversation_audio",
        "live_viewing",
        "stretch_video",
        "full_karaoke",
        "call_response_stopped",
        "oshi_reexperience",
        "relaxation_multisensory",
        "linked_video_recommendation"
      ],
      "title": "ServiceId",
      "type": "string"
    }
  },
  "description": "A snapshot of the journey at a point in the proposal run.",
  "properties": {
    "active_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Active Plan Id"
    },
    "active_service_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServiceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_plan_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Plan Ref"
    },
    "lifecycle_stage": {
      "$ref": "#/$defs/LifecycleStage"
    },
    "motion_state": {
      "$ref": "#/$defs/MotionState"
    },
    "playback_state": {
      "$ref": "#/$defs/PlaybackState",
      "default": "idle"
    },
    "previous_content": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreviousContent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rejected_service_ids": {
      "items": {
        "$ref": "#/$defs/ServiceId"
      },
      "title": "Rejected Service Ids",
      "type": "array"
    }
  },
  "required": [
    "lifecycle_stage",
    "motion_state",
    "active_service_id",
    "active_plan_id"
  ],
  "title": "JourneyState",
  "type": "object"
}
