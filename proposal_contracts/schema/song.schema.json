        "full_karaoke_available": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "Full Karaoke Available",
          "type": "integer"
        },
        "humming_karaoke_available": {
          "default": 1,
          "enum": [
            0,
            1
          ],
          "title": "Humming Karaoke Available",
          "type": "integer"
        }
      },
