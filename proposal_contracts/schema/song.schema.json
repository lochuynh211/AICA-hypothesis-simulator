  "additionalProperties": false,
  "description": "Top-level song wrapper.\n\nExactly three namespaces: spotify_track, spotify_audio_features, simulation_flags.\nextra=\"forbid\" — unknown top-level namespaces are rejected (namespace-strict).\n\nCross-object identity (model_validator):\n- track.id == audio_features.id\n- track.uri == audio_features.uri\n- track.duration_ms == audio_features.duration_ms",
  "properties": {
    "simulation_flags": {
      "$ref": "#/$defs/SimulationFlags"
    },
    "spotify_audio_features": {
      "$ref": "#/$defs/SpotifyAudioFeatures"
    },
    "spotify_track": {
      "$ref": "#/$defs/SpotifyTrack"
    }
  },
  "required": [
    "spotify_track",
    "spotify_audio_features"
  ],
  "title": "Song",
  "type": "object"
}
