FROM python:3.12-slim

# Corporate proxy CA cert (for environments with SSL-inspecting proxies)
COPY corporate-proxy.crt /usr/local/share/ca-certificates/corporate-proxy.crt
RUN update-ca-certificates || true
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Allow pip and uv to work behind SSL-inspecting proxies
ARG PIP_TRUSTED_HOST="pypi.org files.pythonhosted.org pypi.python.org"
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
ENV UV_NATIVE_TLS=true
ENV UV_INSECURE_HOST="pypi.org files.pythonhosted.org"

RUN pip install uv

WORKDIR /app

# Copy dependency manifests only — stable cache layer for third-party deps
COPY app/api/pyproject.toml app/api/uv.lock ./

# Install third-party deps without the local project so this layer is stable
# across source changes (adding main.py, editing aica_api/, etc.)
RUN uv sync --frozen --no-install-project

# Copy full source now that deps are cached
COPY app/api/ ./

# Register/build the local aica_api package (fast — third-party already installed)
RUN uv sync --frozen

EXPOSE 8137

CMD ["uv", "run", "uvicorn", "aica_api.main:app", "--host", "0.0.0.0", "--port", "8137", "--reload"]
