FROM node:22

# Corporate proxy CA cert (for environments with SSL-inspecting proxies)
COPY corporate-proxy.crt /usr/local/share/ca-certificates/corporate-proxy.crt
RUN update-ca-certificates || true
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app

# Disable strict SSL for npm behind corporate proxies
RUN npm config set strict-ssl false

# Copy dependency manifests first for layer caching
COPY app/frontend/package.json app/frontend/package-lock.json ./

RUN npm ci

# Copy the rest of the frontend source
COPY app/frontend/ ./

EXPOSE 5180

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5180"]
