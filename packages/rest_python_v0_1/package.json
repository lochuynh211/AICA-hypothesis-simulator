{
  "id": "rest_python_v0_1",
  "version": "0.1.0",
  "label": {
    "ja": "Pythonポート版 重みスコアベース休憩提案 v0.1",
    "en": "Python Port of Weighted Score Rest Proposal v0.1"
  },
  "compatible_scenario_types": ["uc01_fatigue"],
  "algorithm": {
    "type": "python_module",
    "entrypoint": "algorithm.py"
  },
  "features": [
    { "key": "drowsiness_score", "band_values": [] },
    { "key": "fatigue_score", "band_values": [] },
    { "key": "driving_anomaly_score", "band_values": [] },
    { "key": "attention_drop_score", "band_values": [] },
    { "key": "future_fatigue_score", "band_values": [] },
    { "key": "monotony_score", "band_values": [] },
    { "key": "familiar_route_score", "band_values": [] },
    { "key": "traffic_jam_score", "band_values": [] },
    { "key": "long_highway_score", "band_values": [] },
    { "key": "rest_window_score", "band_values": [] },
    { "key": "rest_scarcity_score", "band_values": [] }
  ],
  "parameters": [],
  "hyperparameters": [
    {
      "key": "w_drowsiness",
      "label": { "ja": "眠気スコア重み", "en": "Drowsiness Weight" },
      "kind": "numeric",
      "default": 0.40,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_fatigue",
      "label": { "ja": "疲労スコア重み", "en": "Fatigue Weight" },
      "kind": "numeric",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_driving_anomaly",
      "label": { "ja": "運転異常スコア重み", "en": "Driving Anomaly Weight" },
      "kind": "numeric",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_future_fatigue",
      "label": { "ja": "将来疲労スコア重み", "en": "Future Fatigue Weight" },
      "kind": "numeric",
      "default": 0.10,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "minimum_risk_for_rest_bonus",
      "label": { "ja": "休憩ボーナス最小リスク", "en": "Minimum Risk for Rest Bonus" },
      "kind": "numeric",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_rest_window",
      "label": { "ja": "休憩タイミング重み", "en": "Rest Window Weight" },
      "kind": "numeric",
      "default": 0.10,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_rest_scarcity",
      "label": { "ja": "休憩希少性重み", "en": "Rest Scarcity Weight" },
      "kind": "numeric",
      "default": 0.08,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_monotony",
      "label": { "ja": "単調性重み", "en": "Monotony Weight" },
      "kind": "numeric",
      "default": 0.30,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_familiar_route",
      "label": { "ja": "慣れた道重み", "en": "Familiar Route Weight" },
      "kind": "numeric",
      "default": 0.20,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_attention_drop",
      "label": { "ja": "注意力低下重み", "en": "Attention Drop Weight" },
      "kind": "numeric",
      "default": 0.25,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_traffic_jam",
      "label": { "ja": "渋滞重み", "en": "Traffic Jam Weight" },
      "kind": "numeric",
      "default": 0.15,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "w_long_highway",
      "label": { "ja": "長距離高速重み", "en": "Long Highway Weight" },
      "kind": "numeric",
      "default": 0.10,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "threshold_suggest",
      "label": { "ja": "提案閾値", "en": "Suggest Threshold" },
      "kind": "numeric",
      "default": 0.62,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "threshold_recommend",
      "label": { "ja": "推奨閾値", "en": "Recommend Threshold" },
      "kind": "numeric",
      "default": 0.76,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "threshold_urgent",
      "label": { "ja": "緊急閾値", "en": "Urgent Threshold" },
      "kind": "numeric",
      "default": 0.88,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "key": "require_rest_actionable",
      "label": { "ja": "休憩実行可能性要件", "en": "Require Rest Actionable" },
      "kind": "bool",
      "default": true
    },
    {
      "key": "rest_actionable_max_min",
      "label": { "ja": "休憩実行可能最大分", "en": "Rest Actionable Max Minutes" },
      "kind": "numeric",
      "default": 30.0,
      "min": 5.0,
      "max": 60.0,
      "step": 5.0
    }
  ],
  "trigger_categories": [
    { "id": "rest_required", "priority": 1 },
    { "id": "monotony_prevention", "priority": 2 }
  ],
  "rules": [],
  "fire_control": {
    "threshold_source": "threshold_suggest",
    "actionability_guard": "rest_spot_reachable"
  },
  "proposals": [
    {
      "id": "rest_guidance",
      "message": {
        "ja": "長時間の運転が続いています。近くの休憩施設でご休憩をお勧めします。",
        "en": "You have been driving for a long time. We recommend resting at the nearby facility."
      },
      "options": ["accept_rest", "postpone", "decline"]
    },
    {
      "id": "monotony_content",
      "message": {
        "ja": "単調な走行が続いています。気分転換をお勧めします。",
        "en": "Monotonous driving detected. Consider a short break or content."
      },
      "options": ["acknowledge", "decline"]
    }
  ],
  "feedback_schema": [],
  "evidence_metrics": []
}
