{
  "id": "mock_service_selector_v1",
  "version": "1.0.0",
  "label": {
    "ja": "モック・サービス選定 v1.0（P1 開発用固定出力）",
    "en": "Mock Service Selector v1.0 (P1 fixed-output stand-in)"
  },
  "kind": "service_selector",
  "family": "service_selector",
  "approach": "transparent",
  "contract_version": "1.0.0",
  "algorithm": {
    "type": "python_module",
    "entrypoint": "algorithm.py",
    "error_mode": "blocking"
  },
  "supported_services": [],
  "parameters": {
    "top_k": 3,
    "tie_breaker": "candidate_id_ascending",
    "missing_policy": "neutral_and_disclose",
    "scene_taxonomy_version": "v1",
    "note": "evaluate() ignores parameters/hyperparameters and returns a FIXED illustrative ranking; this block exists so the editable setup UI renders the real density described in docs/master/aica_transparent_service_proposal_algorithm.md §5-6. When P5 ships its own package, this manifest's shape is superseded."
  },
  "hyperparameters": [
    {
      "key": "response_matrix",
      "kind": "matrix",
      "label": { "ja": "候補応答行列（§5.2）", "en": "Candidate Response Matrix (§5.2)" },
      "default": {
        "driving_services": {
          "music_playlist": { "drowsiness": 0.0, "fatigue": 0.0, "traffic_congested": 0.0, "night": 0.0, "monotony": 0.0, "route": 1.0, "destination": 1.0, "child": 0.0, "group": 0.0, "oshi_registered": 0.5, "oshi_mode": 0.5 },
          "humming_karaoke": { "drowsiness": 1.0, "fatigue": 1.0, "traffic_congested": 1.0, "night": 1.0, "monotony": 1.0, "route": 1.0, "destination": 1.0, "child": 1.0, "group": 1.0, "oshi_registered": 0.5, "oshi_mode": 0.5 },
          "call_response_driving": { "drowsiness": 1.0, "fatigue": 1.0, "traffic_congested": 1.0, "night": 1.0, "monotony": 1.0, "route": 0.0, "destination": 0.0, "child": 1.0, "group": 1.0, "oshi_registered": 0.5, "oshi_mode": 0.5 },
          "quiz": { "drowsiness": 1.0, "fatigue": 1.0, "traffic_congested": 1.0, "night": 1.0, "monotony": 1.0, "route": 0.0, "destination": 0.0, "child": 1.0, "group": 1.0, "oshi_registered": 0.5, "oshi_mode": 0.5 },
          "ranking_creation": { "drowsiness": 1.0, "fatigue": 1.0, "traffic_congested": 1.0, "night": 1.0, "monotony": 1.0, "route": 0.0, "destination": 0.0, "child": 1.0, "group": 1.0, "oshi_registered": 0.5, "oshi_mode": 0.5 },
          "radio_style": { "drowsiness": 0.0, "fatigue": 0.0, "traffic_congested": 0.0, "night": 0.0, "monotony": 0.0, "route": 0.0, "destination": 0.0, "child": 0.0, "group": 0.0, "oshi_registered": 1.0, "oshi_mode": 1.0 }
        },
        "road_type": {
          "music_playlist": { "highway": 0.0, "local": 0.0, "mountain": 0.5, "parking": 0.0 },
          "humming_karaoke": { "highway": 1.0, "local": 0.0, "mountain": -0.5, "parking": 0.0 },
          "call_response_driving": { "highway": 1.0, "local": 0.0, "mountain": -0.5, "parking": 0.0 },
          "quiz": { "highway": 1.0, "local": 0.0, "mountain": -1.0, "parking": 0.0 },
          "ranking_creation": { "highway": 1.0, "local": 0.0, "mountain": -1.0, "parking": 0.0 },
          "radio_style": { "highway": 0.0, "local": 0.0, "mountain": 0.5, "parking": 0.0 }
        },
        "post_rest_services": {
          "live_viewing": { "drowsiness": 0.5, "fatigue": 0.5, "route": 0.0, "destination": 0.0, "child": 1.0, "group": 1.0, "oshi_registered": 1.0, "oshi_mode": 1.0 },
          "stretch_video": { "drowsiness": 1.0, "fatigue": 1.0, "route": 0.0, "destination": 0.0, "child": 0.0, "group": 0.0, "oshi_registered": 0.0, "oshi_mode": 0.0 },
