{
  "id": "rest_rule_based_v0_1",
  "version": "0.1.0",
  "label": {
    "ja": "ルールベース休憩提案 v0.1",
    "en": "Rule-Based Rest Proposal v0.1"
  },
  "compatible_scenario_types": ["uc01_fatigue"],
  "algorithm": {
    "type": "declarative_rule",
    "entrypoint": "rules"
  },
  "features": [
    {
      "key": "drowsiness_level",
      "band_values": ["none", "weak", "moderate", "strong", "severe"]
    },
    {
      "key": "fatigue_level",
      "band_values": ["low", "medium", "high"]
    },
    {
      "key": "signal_duration",
      "band_values": ["transient", "brief", "sustained", "persistent"]
    },
    {
      "key": "continuous_driving_time",
      "band_values": ["short", "moderate", "long"]
    },
    {
      "key": "rest_spot_eta",
      "band_values": ["none", "near", "far"]
    }
  ],
  "parameters": [],
  "hyperparameters": [
    {
      "key": "trigger_sensitivity",
      "label": {"ja": "感知感度", "en": "Trigger Sensitivity"},
      "kind": "band",
      "band_values": ["low", "medium", "high"],
      "default": "medium"
    },
    {
      "key": "proposal_threshold",
      "label": {"ja": "提案閾値", "en": "Proposal Threshold"},
      "kind": "band",
      "band_values": ["low", "medium", "high"],
      "default": "medium"
    },
    {
      "key": "severe_threshold",
      "label": {"ja": "重大閾値", "en": "Severe Threshold"},
      "kind": "band",
      "band_values": ["low", "medium", "high"],
      "default": "medium"
    },
    {
      "key": "persistence_requirement",
      "label": {"ja": "継続要件", "en": "Persistence Requirement"},
      "kind": "band",
      "band_values": ["low", "medium", "high"],
      "default": "medium"
    },
    {
      "key": "require_actionable",
      "label": {"ja": "実行可能性要件", "en": "Require Actionable"},
      "kind": "bool",
      "default": true
    },
    {
      "key": "rest_spot_sensitivity",
      "label": {"ja": "休憩スポット感度", "en": "Rest Spot Sensitivity"},
      "kind": "band",
      "band_values": ["low", "medium", "high"],
      "default": "medium"
    }
  ],
  "trigger_categories": [
    {"id": "rest_required", "priority": 1}
  ],
  "rules": [
    {
      "id": "R1",
      "name": "SEVERE_INTERVENTION",
      "description": "Drowsiness is severe, or the damped fatigue/drowsiness blend reaches the severe cut-point.",
      "condition": "drowsiness_level == 'severe' OR damped >= severeCut",
      "action": "SEVERE_INTERVENTION"
    },
    {
      "id": "R2",
      "name": "NO_PRACTICAL_ACTION_FALLBACK",
      "description": "Blend reaches the proposal cut-point but no actionable rest spot is reachable.",
      "condition": "damped >= proposalCut AND NOT restReachable",
      "action": "NO_PRACTICAL_ACTION_FALLBACK"
    },
    {
      "id": "R3",
      "name": "REST_PROPOSAL",
      "description": "Blend reaches the proposal cut-point and a rest spot is reachable.",
      "condition": "damped >= proposalCut AND restReachable",
      "action": "REST_PROPOSAL"
    },
    {
      "id": "R4",
      "name": "SOFT_WARNING",
      "description": "Blend reaches the reaction point but not the proposal cut-point.",
      "condition": "damped >= reactionPoint",
      "action": "SOFT_WARNING"
    },
    {
      "id": "R5",
      "name": "NO_TRIGGER",
      "description": "Catch-all: blend is below the reaction point.",
      "condition": "catch-all",
      "action": "NO_TRIGGER"
    }
  ],
  "fire_control": {
    "threshold_source": "proposal_threshold",
    "actionability_guard": "rest_spot_reachable"
  },
  "proposals": [
    {
      "id": "rest_guidance",
      "message": {
        "ja": "長時間の運転が続いています。近くの休憩施設でご休憩をお勧めします。",
        "en": "You have been driving for a long time. We recommend resting at the nearby facility."
      },
      "options": ["accept_rest", "postpone"]
    }
  ],
  "feedback_schema": [],
  "evidence_metrics": []
}
