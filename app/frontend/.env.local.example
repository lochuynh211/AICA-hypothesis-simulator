# Dev-only Maps presets for local testing. Copy to `.env.local` (gitignored) and
# fill your own key. VITE_* vars are inlined by Vite at build time — DEV ONLY,
# never use for a shipped production build (it would embed the key).
VITE_GOOGLE_MAPS_KEY=your_google_maps_browser_key_here
VITE_MAPS_START=Tokyo Station
VITE_MAPS_END=Osaka Station
