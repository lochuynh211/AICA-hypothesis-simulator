        {
          "key": "require_actionable",
          "label": {
            "ja": "\u5b9f\u884c\u53ef\u80fd\u6027\u8981\u4ef6",
            "en": "Require Actionable"
          },
          "kind": "bool",
          "default": true
        },
        {
          "key": "rest_spot_sensitivity",
          "label": {
            "ja": "\u4f11\u61a9\u30b9\u30dd\u30c3\u30c8\u611f\u5ea6",
            "en": "Rest Spot Sensitivity"
          },
          "kind": "band",
          "band_values": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium"
        }
      ],
      "trigger_categories": [
        {
          "id": "rest_required",
          "priority": 1
        }
      ],
      "rules": [
        {
          "id": "R1",
          "name": "SEVERE_INTERVENTION",
          "description": "Drowsiness is severe, or the damped fatigue/drowsiness blend reaches the severe cut-point.",
          "condition": "drowsiness_level == 'severe' OR damped >= severeCut",
          "action": "SEVERE_INTERVENTION"
        },
        {
          "id": "R2",
          "name": "NO_PRACTICAL_ACTION_FALLBACK",
          "description": "Blend reaches the proposal cut-point but no actionable rest spot is reachable.",
          "condition": "damped >= proposalCut AND NOT restReachable",
          "action": "NO_PRACTICAL_ACTION_FALLBACK"
        },
        {
          "id": "R3",
          "name": "REST_PROPOSAL",
          "description": "Blend reaches the proposal cut-point and a rest spot is reachable.",
          "condition": "damped >= proposalCut AND restReachable",
          "action": "REST_PROPOSAL"
        },
        {
          "id": "R4",
          "name": "SOFT_WARNING",
          "description": "Blend reaches the reaction point but not the proposal cut-point.",
          "condition": "damped >= reactionPoint",
          "action": "SOFT_WARNING"
        },
        {
          "id": "R5",
          "name": "NO_TRIGGER",
          "description": "Catch-all: blend is below the reaction point.",
          "condition": "catch-all",
          "action": "NO_TRIGGER"
        }
      ],
      "fire_control": {
        "threshold_source": "proposal_threshold",
        "actionability_guard": "rest_spot_reachable"
      },
      "proposals": [
        {
          "id": "rest_guidance",
          "message": {
            "ja": "\u9577\u6642\u9593\u306e\u904b\u8ee2\u304c\u7d9a\u3044\u3066\u3044\u307e\u3059\u3002\u8fd1\u304f\u306e\u4f11\u61a9\u65bd\u8a2d\u3067\u3054\u4f11\u61a9\u3092\u304a\u52e7\u3081\u3057\u307e\u3059\u3002",
            "en": "You have been driving for a long time. We recommend resting at the nearby facility."
          },
          "options": [
            "accept_rest",
            "postpone"
          ]
        }
      ],
      "feedback_schema": [],
      "evidence_metrics": []
    },
    "scenario": {
      "_comment": [
        "Scenario: UC-01 fatigue/drowsiness with staged recovery options (M7 Task 12).",
        "",
        "This scenario is derived from uc01_fatigue_friend_drive_v0_1 and adds a",
        "recovery_options array so that accept_rest triggers a staged recovery sequence",
        "instead of completing the run immediately (the pre-M7 back-compat path).",
        "",
        "Recovery options:",
        "  nap_karaoke        \u2014 long rest: wakefulness (MOVING) \u2192 nap 3 ticks \u2192 karaoke 3 ticks",
        "  convenience_stretch \u2014 short rest: wakefulness (MOVING) \u2192 stretch 2 ticks",
        "  postpone           \u2014 postpone=true, no stages (acts as continue driving)",
        "",
        "Proposal timeline (identical to friend_drive \u2014 same profile, route, presets):",
        "  Tick ~29: declarative_rule fires REST_PROPOSAL (high fatigue + moderate drowsiness).",
        "            rest spot at 60 km, ~30 min ahead.",
        "  After accept_rest(nap_karaoke): wakefulness until 60 km \u2192 nap (3 ticks STOPPED) \u2192",
        "            content (3 ticks STOPPED) \u2192 resuming \u2192 route completion.",
        "",
        "uc01_fatigue_friend_drive_v0_1 is left UNTOUCHED (no recovery_options) so that",
        "existing tests that call accept_rest expecting immediate completion still pass.",
        "",
        "allowed_actions includes decline (M7 requirement) in addition to accept_rest/postpone."
      ],
      "id": "uc01_fatigue_recovery_v0_1",
      "version": "0.1.0",
      "type": "uc01_fatigue",
      "persona": {
        "name": "Haruto Tanaka",
