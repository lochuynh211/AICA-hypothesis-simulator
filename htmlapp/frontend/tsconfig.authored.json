{
  "extends": "./tsconfig.json",
  "include": [
    "src/vite-env.d.ts",
    "src/config.ts",
    "src/api/**/*",
    "src/engine/**/*",
    "src/storage/**/*",
    "src/data/**/*",
    "src/components/**/*",
    "src/state/**/*",
    "src/lib/**/*",
    "src/i18n/**/*",
    "src/replay/**/*"
  ],
  // NOTE on 4 known upstream-only type errors (ScenarioBeats.tsx,
  // MapSurface.tsx, RunLogViewer.tsx, DecisionTracePanel.tsx): they are
  // NOT listed in `exclude` below. TypeScript's `exclude` only prunes
  // which files the `include` globs pick up as root files — a file is
  // still type-checked if another included file imports it (all four
  // are: LeftContextPanel.tsx, CenterPlaybackPanel.tsx, RunsScreen.tsx,
  // ReplayViewer.tsx/RightReviewPanel.tsx). Confirmed empirically: adding
  // them here changed nothing. The actual suppression lives in
  // scripts/typecheck.mjs (KNOWN_UPSTREAM_ONLY_ERRORS), which filters
  // tsc's diagnostic output by file path after running the real,
  // unmodified compiler — run `npm run typecheck`, not raw `tsc`.
  "exclude": [
    "node_modules",
    "src/engine/algorithms/js_module.ts"
  ]
}
